# 배포 패키지 버전과 동일하게 유지합니다.
SQLADVISOR_VERSION=1.0.0
HTTP_PORT=80

# 세 값의 비밀번호를 동일하게 변경합니다.
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sqladvisor
SPRING_DATASOURCE_USERNAME=sqladvisor
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://sqladvisor:CHANGE_ME@postgres:5432/sqladvisor

# local | openai | gemini | internal | ollama
AWR_LLM_PROVIDER=local
# none | openai | gemini | internal | ollama
AWR_EMBEDDING_PROVIDER=none
AWR_AI_TIMEOUT_SECONDS=120
AWR_RAG_TOP_K=8

OCR_LANG=eng+kor
OCR_MAX_PAGES=20

# 외부 공개 전 true로 변경하고 인증 방식을 구성해야 합니다.
APP_AUTH_ENABLED=false
# external: Google 로그인, internal: 사내 포털/프록시 연동
APP_AUTH_MODE=external
GOOGLE_CLIENT_ID=
APP_ALLOWED_GOOGLE_DOMAINS=
APP_ADMIN_EMAILS=
APP_INTERNAL_AUTH_EMAIL_DOMAIN=internal.local
APP_LOCAL_LOGIN_ENABLED=false
APP_SESSION_TIMEOUT_MINUTES=120

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI 호환 내부 모델
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_CHAT_MODEL=gemma4-31b
INTERNAL_EMBEDDING_BASE_URL=
INTERNAL_EMBEDDING_MODEL=genai-bge-m3

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=embeddinggemma

